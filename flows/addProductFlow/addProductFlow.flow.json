          "__example__": [
            {
              "src": "iVBORw0KGgo...",
              "alt-text": "Photo 3"
            }
          ]
        },
        "show_carousel_2": {
          "type": "boolean",
          "__example__": true
        },
        "product_name": {
          "type": "string",
          "__example__": "Robe d'ete fleurie"
        },
        "product_category": {
          "type": "string",
          "__example__": "Mode & Vêtements"
        },
        "product_subcategory": {
          "type": "string",
          "__example__": "Mode & Vêtements > Robes"
        },
        "prix_regulier_tnd": {
          "type": "string",
          "__example__": "100"
        },
        "prix_promo_tnd": {
          "type": "string",
          "__example__": "0"
        },
        "prix_regulier_eur": {
          "type": "string",
          "__example__": "38"
        },
        "prix_promo_eur": {
          "type": "string",
          "__example__": "0"
        },
        "longueur": {
          "type": "string",
          "__example__": "20"
        },
        "largeur": {
          "type": "string",
          "__example__": "15"
        },
        "profondeur": {
          "type": "string",
          "__example__": "10"
        },
        "longueur_label": {
          "type": "string",
          "__example__": "Longueur : 20 cm"
        },
        "largeur_label": {
          "type": "string",
          "__example__": "Largeur : non mentionnée"
        },
        "profondeur_label": {
          "type": "string",
          "__example__": "Profondeur : 10 cm"
        },
        "unite_dimension": {
          "type": "string",
          "__example__": "cm"
        },
        "show_dimensions": {
          "type": "boolean",
          "__example__": true
        },
        "valeur_poids": {
          "type": "string",
          "__example__": "0"
        },
        "unite_poids": {
          "type": "string",
          "__example__": "kg"
        },
        "couleur": {
          "type": "string",
          "__example__": ""
        },
        "taille": {
          "type": "string",
          "__example__": ""
        },
        "quantite": {
          "type": "string",
          "__example__": "5"
        },
        "error_message": {
          "type": "string",
          "__example__": " erreur"
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextHeading",
            "text": "✅ Recapitulatif du produit"
          },
          {
            "type": "TextBody",
            "text": "Vérifiez les informations avant de soumettre."
          },
          {
            "type": "TextSubheading",
            "text": "🖼️ Photos"
          },
          {
            "type": "ImageCarousel",
            "scale-type": "cover",
            "images": "${data.images}"
          },
          {
            "type": "ImageCarousel",
            "scale-type": "cover",
            "images": "${data.images_2}",
            "visible": "${data.show_carousel_2}"
          },
          {
            "type": "TextCaption",
            "text": "Seulement les premières photos sont affichées, consultez seller app pour voir toutes les photos."
          },
          {
            "type": "TextSubheading",
            "text": "🏷️ Nom"
          },
          {
            "type": "TextBody",
            "text": "${data.product_name}"
          },
          {
            "type": "TextSubheading",
            "text": "📂 Catégorie"
          },
          {
            "type": "TextBody",
            "text": "${data.product_category}"
          },
          {
            "type": "TextSubheading",
            "text": "📁 Sous-catégorie"
          },
          {
            "type": "TextBody",
            "text": "${data.product_subcategory}"
          },
          {
            "type": "TextSubheading",
            "text": "Prix TND"
          },
          {
            "type": "TextBody",
            "text": "`'Prix régulier: ' ${data.prix_regulier_tnd} ' TND'`"
          },
          {
            "type": "If",
            "condition": "${data.prix_promo_tnd}!=''",
            "then": [
              {
                "type": "TextBody",
                "text": "`'Prix promo: ' ${data.prix_promo_tnd} ' TND'`"
              }
            ],
            "else": [
              {
                "type": "TextBody",
                "text": "Aucun prix promo TND.",
                "visible": true
              }
            ]
          },
          {
            "type": "TextSubheading",
            "text": "💶 Prix EUR"
          },
          {
            "type": "TextBody",
            "text": "`'Prix régulier: ' ${data.prix_regulier_eur} ' EUR'`"
          },
          {
            "type": "If",
            "condition": "${data.prix_promo_eur} !=''",
            "then": [
              {
                "type": "TextBody",
                "text": "`'Prix promo: ' ${data.prix_promo_eur} ' EUR'`"
              }
            ],
            "else": [
              {
                "type": "TextBody",
                "text": "Aucun prix promo EUR.",
                "visible": true
              }
            ]
          },
          {
            "type": "TextSubheading",
            "text": "📐 Dimensions"
          },
          {
            "type": "TextBody",
            "text": "${data.longueur_label}"
          },
          {
            "type": "If",
            "condition": "${data.largeur_label} != ''",
            "then": [
              {
                "type": "TextBody",
                "text": "${data.largeur_label}"
              }
            ]
          },
          {
            "type": "If",
            "condition": "${data.profondeur_label} != ''",
            "then": [
              {
                "type": "TextBody",
                "text": "${data.profondeur_label}"
              }
            ]
          },
          {
            "type": "If",
            "condition": "${data.valeur_poids} !=''",
            "then": [
              {
                "type": "TextSubheading",
                "text": "⚖️ Poids / Volume"
              },
              {
                "type": "TextBody",
                "text": "`${data.valeur_poids} ' ' ${data.unite_poids}`"
              }
            ],
            "else": [
              {
                "type": "TextBody",
                "text": "Pas de poids.",
                "visible": true
              }
            ]
          },
          {
            "type": "If",
            "condition": "${data.couleur} != ''",
            "then": [
              {
                "type": "TextSubheading",
                "text": "🎨 Couleur"
              },
              {
                "type": "TextBody",
                "text": "${data.couleur}"
              }
            ],
            "else": [
              {
                "type": "TextBody",
                "text": "Pas de couleur.",
                "visible": true
              }
            ]
          },
          {
            "type": "If",
            "condition": "${data.taille} != ''",
            "then": [
              {
                "type": "TextSubheading",
                "text": "📏 Taille"
              },
              {
                "type": "TextBody",
                "text": "${data.taille}"
              }
            ],
            "else": [
              {
                "type": "TextBody",
                "text": "Pas de taille.",
                "visible": true
              }
            ]
          },
          {
            "type": "TextSubheading",
            "text": "📦 Quantité en stock"
          },
          {
            "type": "TextBody",
            "text": "`${data.quantite} ' unités'`"
          },
          {
            "type": "TextSubheading",
            "text": "${data.error_message}",
            "visible": "`${data.error_message}!=''`"
          },
          {
            "type": "Footer",
            "label": "Soumettre le produit",
            "enabled": "`${data.error_message}==''`",
            "on-click-action": {
              "name": "data_exchange",
              "payload": {
                "product_name": "${data.product_name}",
                "product_category": "${data.product_category}",
                "product_subcategory": "${data.product_subcategory}",
                "prix_regulier_tnd": "${data.prix_regulier_tnd}",
                "prix_promo_tnd": "${data.prix_promo_tnd}",
                "prix_regulier_eur": "${data.prix_regulier_eur}",
                "prix_promo_eur": "${data.prix_promo_eur}",
                "longueur": "${data.longueur}",
                "largeur": "${data.largeur}",
                "profondeur": "${data.profondeur}",
                "unite_dimension": "${data.unite_dimension}",
                "valeur_poids": "${data.valeur_poids}",
                "unite_poids": "${data.unite_poids}",
                "couleur": "${data.couleur}",
                "taille": "${data.taille}",
                "quantite": "${data.quantite}"
              }
            }
          }
        ]
      }
    },
    {
      "id": "SUCCESS",
      "title": "Succès",
      "terminal": true,
      "success": true,
      "data": {},
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextHeading",
            "text": "Succès"
          },
          {
            "type": "Footer",
            "label": "Fermer",
            "on-click-action": {
              "name": "complete",
              "payload": {}
            }
          }
        ]
      }
    }
  ]
}
