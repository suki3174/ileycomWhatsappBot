{
  "version": "7.3",
  "data_api_version": "3.0",
  "routing_model": {
    "WELCOME_SCREEN": [
      "ORDER_STATUS"
    ],
    "ORDER_STATUS": [
      "ORDER_LIST"
    ],
    "ORDER_LIST": [
      "ORDER_DETAIL"
    ],
    "ORDER_DETAIL": [
      "ORDER_ARTICLES",
      "SUCCESS"
    ],
    "ORDER_ARTICLES": [
      "SUCCESS"
    ]
  },
  "screens": [
    {
      "id": "WELCOME_SCREEN",
      "title": "Bienvenue",
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextHeading",
            "text": "🛒 Gestionnaire de Commandes"
          },
          {
            "type": "TextBody",
            "text": "👋 Bonjour ! Cet outil vous permet de visualiser et de suivre toutes vos commandes en temps réel."
          },
          {
            "type": "TextSubheading",
            "text": "Ce que vous pouvez faire :"
          },
          {
            "type": "TextBody",
            "text": "• 📊 Consulter le résumé de vos commandes.\n• 🔍 Parcourir la liste de vos commandes.\n• 📦 Vérifier le statut de chaque commande.\n• 🧾 Consulter les détails complets d'une commande."
          },
          {
            "type": "TextCaption",
            "text": "Appuyez sur le bouton ci-dessous pour commencer. 👇"
          },
          {
            "type": "Footer",
            "label": "Voir mes commandes",
            "on-click-action": {
              "name": "data_exchange",
              "payload": {
                "cmd": "init"
              }
            }
          }
        ]
      }
    },
    {
      "id": "ORDER_STATUS",
      "title": "Statut des Commandes",
      "data": {
        "error_msg": {
          "type": "string",
          "__example__": ""
        },
        "statuses": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              }
            }
          },
          "__example__": [
            {
              "id": "all",
              "title": "🗂️ Toutes — 16000"
            },
            {
              "id": "completed",
              "title": "✅ Livrée — 9998"
            },
            {
              "id": "in_delivery",
              "title": "🚚 En livraison — 74"
            },
            {
              "id": "pending",
              "title": "⏳ En traitement — 71"
            },
            {
              "id": "cancelled",
              "title": "❌ Annulée — 5416"
            },
            {
              "id": "refunded",
              "title": "↩️ Remboursée — 52"
            },
            {
              "id": "anomaly",
              "title": "⚠️ Anomalie — 33"
            }
          ]
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextBody",
            "text": "Filtrez vos commandes par statut avant de consulter la liste."
          },
          {
            "type": "TextHeading",
            "text": "Sélectionnez un statut"
          },
          {
            "type": "TextBody",
            "text": "${data.error_msg}",
            "visible": "`${data.error_msg != ''}`"
          },
          {
            "type": "Form",
            "name": "status_form",
            "children": [
              {
                "type": "RadioButtonsGroup",
                "label": "Statut des commandes",
                "name": "status_filter",
                "data-source": "${data.statuses}",
                "required": true
              },
              {
                "type": "Footer",
                "label": "Voir la liste",
                "on-click-action": {
                  "name": "data_exchange",
                  "payload": {
                    "status_filter": "${form.status_filter}",
                    "cmd": "filter_orders"
                  }
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": "ORDER_LIST",
      "title": "Mes commandes",
      "data": {
        "current_page": {
          "type": "number",
          "__example__": 1
        },
        "status_filter": {
          "type": "string",
          "__example__": "all"
        },
        "orders": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "main-content": {
                "type": "object",
                "properties": {
                  "title": {
                    "type": "string"
                  },
                  "description": {
                    "type": "string"
                  },
                  "metadata": {
                    "type": "string"
                  }
                }
              },
              "end": {
                "type": "object",
                "properties": {
                  "title": {
                    "type": "string"
                  },
                  "metadata": {
                    "type": "string"
                  }
                }
              },
              "tags": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "on-click-action": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "payload": {
                    "type": "object"
                  }
                }
              }
            }
          },
          "__example__": [
            {
              "id": "1001",
              "main-content": {
                "title": "CMD-1001",
                "description": "John Doe",
                "metadata": "2026-06-11 · 3 articles"
              },
              "end": {
                "title": "120.00",
                "metadata": "TND"
              },
              "tags": [
                "completed"
              ],
              "on-click-action": {
                "name": "data_exchange",
                "payload": {
                  "order_id": "1001",
                  "cmd": "order_details"
                }
              }
            },
            {
              "id": "nav_next",
              "main-content": {
                "title": "Page Suivante ➡️",
                "metadata": "Page 2 / 5"
              },
              "end": {
                "title": "",
                "metadata": ""
              },
              "tags": [],
              "on-click-action": {
                "name": "data_exchange",
                "payload": {
                  "page": 2,
                  "cmd": "paginate"
                }
              }
            }
          ]
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "NavigationList",
            "name": "orders_nav",
            "list-items": "${data.orders}"
          }
        ]
      }
    },
    {
      "id": "ORDER_DETAIL",
      "title": "Détail de la commande",
      "data": {
        "order_id": {
          "type": "string",
          "__example__": "1001"
        },
        "order_ref": {
          "type": "string",
          "__example__": "CMD-1001"
        },
        "order_date": {
          "type": "string",
          "__example__": "2026-06-11"
        },
        "status": {
          "type": "string",
          "__example__": "✅ Commande terminée"
        },
        "total": {
          "type": "string",
          "__example__": "120.00 TND"
        },
        "payment_method": {
          "type": "string",
          "__example__": "Cash"
        },
        "transaction_id": {
          "type": "string",
          "__example__": "TRX-001"
        },
        "customer_note": {
          "type": "string",
          "__example__": "Call before delivery"
        },
        "articles_summary": {
          "type": "string",
          "__example__": "3 articles — 100.00 TND"
        },
        "billing_info": {
          "type": "string",
          "__example__": "Billing address text"
        },
        "shipping_info": {
          "type": "string",
          "__example__": "Shipping address text"
        },
        "subtotal": {
          "type": "string",
          "__example__": "100.00 TND"
        },
        "shipping_cost": {
          "type": "string",
          "__example__": "20.00 TND"
        },
        "total_summary": {
          "type": "string",
          "__example__": "120.00 TND"
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextHeading",
            "text": "${data.order_ref}"
          },
          {
            "type": "TextBody",
            "text": "${data.order_date}"
          },
          {
            "type": "TextBody",
            "text": "${data.status}"
          },
          {
            "type": "TextSubheading",
            "text": "Total"
          },
          {
            "type": "TextBody",
            "text": "${data.total}"
          },
          {
            "type": "TextSubheading",
            "text": "Paiement"
          },
          {
            "type": "TextCaption",
            "text": "${data.payment_method}"
          },
          {
            "type": "TextCaption",
            "text": "${data.transaction_id}"
          },
          {
            "type": "TextSubheading",
            "text": "Articles"
          },
          {
            "type": "TextBody",
            "text": "${data.articles_summary}"
          },
          {
            "type": "TextSubheading",
            "text": "Note client"
          },
          {
            "type": "TextCaption",
            "text": "${data.customer_note}"
          },
          {
            "type": "TextSubheading",
            "text": "Facturation"
          },
          {
            "type": "TextCaption",
            "text": "${data.billing_info}"
          },
          {
            "type": "TextSubheading",
            "text": "Livraison"
          },
          {
            "type": "TextCaption",
            "text": "${data.shipping_info}"
          },
          {
            "type": "Footer",
            "label": "Voir les articles",
            "on-click-action": {
              "name": "data_exchange",
              "payload": {
                "cmd": "load_articles",
                "order_id": "${data.order_id}",
                "order_ref": "${data.order_ref}",
                "page": 1
              }
            }
          }
        ]
      }
    },
    {
      "id": "ORDER_ARTICLES",
      "title": "Articles de la commande",
      "terminal": true,
      "data": {
        "order_id": {
          "type": "string",
          "__example__": "1001"
        },
        "order_ref": {
          "type": "string",
          "__example__": "CMD-1001"
        },
        "current_page": {
          "type": "number",
          "__example__": 1
        },
        "next_page": {
          "type": "number",
          "__example__": 2
        },
        "prev_page": {
          "type": "number",
          "__example__": 1
        },
        "total_pages": {
          "type": "number",
          "__example__": 3
        },
        "has_next": {
          "type": "boolean",
          "__example__": true
        },
        "has_prev": {
          "type": "boolean",
          "__example__": false
        },
        "page_label": {
          "type": "string",
          "__example__": "Page 1 / 3"
        },
        "p1_img": {
          "type": "string",
          "__example__": "https://example.com/p1.jpg"
        },
        "p1_name": {
          "type": "string",
          "__example__": "Item 1"
        },
        "p1_sku": {
          "type": "string",
          "__example__": "SKU-1"
        },
        "p1_qty_price": {
          "type": "string",
          "__example__": "1 x 10.00 TND"
        },
        "p1_visible": {
          "type": "boolean",
          "__example__": true
        },
        "p2_img": {
          "type": "string",
          "__example__": "https://example.com/p2.jpg"
        },
        "p2_name": {
          "type": "string",
          "__example__": "Item 2"
        },
        "p2_sku": {
          "type": "string",
          "__example__": "SKU-2"
        },
        "p2_qty_price": {
          "type": "string",
          "__example__": "2 x 20.00 TND"
        },
        "p2_visible": {
          "type": "boolean",
          "__example__": true
        },
        "p3_img": {
          "type": "string",
          "__example__": "https://example.com/p3.jpg"
        },
        "p3_name": {
          "type": "string",
          "__example__": "Item 3"
        },
        "p3_sku": {
          "type": "string",
          "__example__": "SKU-3"
        },
        "p3_qty_price": {
          "type": "string",
          "__example__": "1 x 30.00 TND"
        },
        "p3_visible": {
          "type": "boolean",
          "__example__": true
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextHeading",
            "text": "${data.order_ref}"
          },
          {
            "type": "TextCaption",
            "text": "${data.page_label}"
          },
          {
            "type": "TextSubheading",
            "text": "Article 1"
          },
          {
            "type": "TextBody",
            "text": "${data.p1_name}"
          },
          {
            "type": "TextCaption",
            "text": "${data.p1_sku}"
          },
          {
            "type": "TextCaption",
            "text": "${data.p1_qty_price}"
          },
          {
            "type": "TextSubheading",
            "text": "Article 2"
          },
          {
            "type": "TextBody",
            "text": "${data.p2_name}"
          },
          {
            "type": "TextCaption",
            "text": "${data.p2_sku}"
          },
          {
            "type": "TextCaption",
            "text": "${data.p2_qty_price}"
          },
          {
            "type": "TextSubheading",
            "text": "Article 3"
          },
          {
            "type": "TextBody",
            "text": "${data.p3_name}"
          },
          {
            "type": "TextCaption",
            "text": "${data.p3_sku}"
          },
          {
            "type": "TextCaption",
            "text": "${data.p3_qty_price}"
          },
          {
            "type": "Footer",
            "label": "Fermer",
            "on-click-action": {
              "name": "data_exchange",
              "payload": {
                "confirm_action": true
              }
            }
          }
        ]
      }
    },
    {
      "id": "SUCCESS",
      "title": "Succès",
      "terminal": true,
      "data": {
        "message": {
          "type": "string",
          "__example__": "Action terminée avec succès !"
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextHeading",
            "text": "${data.message}"
          },
          {
            "type": "Footer",
            "label": "Fermer",
            "on-click-action": {
              "name": "complete",
              "payload": {
                "status": "success"
              }
            }
          }
        ]
      }
    }
  ]
}
